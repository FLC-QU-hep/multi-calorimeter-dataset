<?xml version="1.0" encoding="UTF-8"?>
<lccdd xmlns:compact="http://www.lcsim.org/schemas/compact/1.0"
       xmlns:xs="http://www.w3.org/2001/XMLSchema"
       xs:noNamespaceSchemaLocation="http://www.lcsim.org/schemas/compact/1.0/compact.xsd">

  <info name="SimpleBox"
        title="Simple Sampling Calorimeter Box with Planar Geometry"
        author="L.Valente"
        url="no"
        status="development"
        version="1.0">
    <comment>
      A simple and configurable implementation of a sampling calorimeter block.
      Definition of sizes, visualization settings and readout are specified.
    </comment>
  </info>

  <includes>
    <gdmlFile  ref="$elements_path"/>
    <gdmlFile  ref="$materials_path"/>
  </includes>

  <define>
    <constant name="world_size" value="5*m"/>
    <constant name="world_x" value="world_size"/>
    <constant name="world_y" value="world_size"/>
    <constant name="world_z" value="world_size"/>
    <!-- layer dimensions -->
    <constant name="Box_numLayers" value="$num_layers"/><!-- 1"/> -->
    <constant name="Box_activeThickness"  value="$active_thickness*mm"/>
    <constant name="Box_passiveThickness" value="$passive_thickness*mm"/>
    <constant name="Box_layerThickness" value="Box_activeThickness+Box_passiveThickness"/><!-- 200.25*mm"/> -->
    <constant name="Box_sampling_fraction" value="$sampling_fraction"/> 

    <!-- calorimeter volume -->
    <constant name="Box_x" value="50*cm"/>
    <constant name="Box_y" value="50*cm"/>
    <constant name="Box_z" value="Box_numLayers*Box_layerThickness"/>
  </define>

  <display>
    <vis name="ecal_envelope" r="0.1" g="0.2" b="0.6" alpha="1" showDaughers="false" visible="true" />
  </display>
  <!--
  <regions>
    <region name="preECalBarrelRegion" eunit="MeV" lunit="mm" cut="0.001" threshold="0.001"/>
  </regions>
  -->

  <readouts>
    <readout name="ECalBarrelCollection">
      <segmentation type="CartesianGridXY"
        grid_size_x="5*mm"
        grid_size_y="5*mm"/>
        <id>system:4,layer:7,slice:2,x:13:-16,y:-16</id>
    </readout>
  </readouts>

  <!-- This is just a region definition for a trigger plane in front of the calo- only needed if running fast sim in dd4hep
  <detectors>
      <detector name="preECalBarrel" type="SingleBox" region="preECalBarrelRegion">
        <dimensions x="Box_x" y="Box_y" z="Box_z" material="Air"/>
    </detector>
  -->

  <detectors>
    <detector id="1" name="EMCalBlock" type="SandwichPlanes" readout="ECalBarrelCollection">
      <type_flags type=" DetType_CALORIMETER + DetType_ELECTROMAGNETIC"/>
      <sensitive type="CalorimeterSD"/>
      <dimensions x="Box_x" y="Box_y" z="Box_z" vis="ecal_envelope"/>
      <position x="0*mm" y="0*mm" z="Box_z/2"/>
      <layer repeat="Box_numLayers">
        <slice material = "W" thickness = "Box_passiveThickness" sensitive="no"/>
        <slice material = "Si" thickness = "Box_activeThickness" sensitive="yes"/>
        <!-- <slice material = "PbWO4" thickness ="200.25*mm" sensitive="yes"/> -->
      </layer>
    </detector>
  </detectors>

</lccdd>
